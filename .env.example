# Copy to .env (gitignored) and fill in. Never commit real keys.
OPENAI_API_KEY=
# Optional: text model supporting Chat Completions + strict JSON schema.
# No automatic discovery by model name. Default: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional kill switch: 0 = always use template explanations.
COPILOT_ENABLED=1
